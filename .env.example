# ==============================================================================
# TESTSETU AI – PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development. Never commit real production secrets.
# ==============================================================================

# Core App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TestSetu AI"
NEXT_PUBLIC_SUPPORT_EMAIL="support@testsetu.ai"
NODE_ENV=development

# 1. Supabase / PostgreSQL (Tier 3 Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# 2. Google Gemini API (AI Question Extraction, Handwritten OCR, LaTeX formatting)
GEMINI_API_KEY=your_gemini_flash_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. Meta WhatsApp Cloud API (Parent Notifications, OMR Report Cards & Teacher Bot)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=your_system_user_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=testsetu_secure_webhook_secret_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_for_sha256_verification

# 4. Razorpay (Fees, Payment Links & Subscriptions - Currency: INR)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. Resend (Transactional Emails & Password Reset)
RESEND_API_KEY=re_your_resend_api_key

# 6. Security & Rate Limiting
JWT_SECRET=super_secure_testsetu_jwt_secret_change_in_production_32chars
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
